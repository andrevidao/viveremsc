---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import CityCard from '../components/CityCard.astro';
import CostCalculator from '../components/CostCalculator.astro';
import SocialProof from '../components/SocialProof.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Viver em SC",
      "url": "https://viveremsc.com.br",
      "description": "Inteligência de mercado e guias aprofundados para quem quer morar e investir em Santa Catarina.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://viveremsc.com.br/blog?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "name": "Viver em SC",
      "url": "https://viveremsc.com.br",
      "logo": "https://viveremsc.com.br/images/logo-viveremsc.jpg",
      "description": "Guias e dados de mercado para morar e investir em Santa Catarina.",
      "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "email": "contato@viveremsc.com.br" },
    },
  ],
};

const cidades = [
  { name: 'Balneário Camboriú', slug: 'morar-em-balneario-camboriu', image: '/images/cidades/balneario-camboriu.jpg', idh: 0.845, precoM2: '14.5k', populacao: '156k', destaque: 'Mais valorizada' },
  { name: 'Florianópolis', slug: 'morar-em-florianopolis', image: '/images/cidades/florianopolis.jpg', idh: 0.847, precoM2: '11.2k', populacao: '516k', destaque: 'Capital' },
  { name: 'Joinville', slug: 'morar-em-joinville', image: '/images/cidades/joinville.jpg', idh: 0.809, precoM2: '7.8k', populacao: '616k', destaque: 'Maior empregabilidade' },
  { name: 'Itapema', slug: 'morar-em-itapema', image: '/images/cidades/itapema.jpg', idh: 0.796, precoM2: '12.1k', populacao: '73k', destaque: 'Maior potencial de investimento' },
];
---

<Base title="Morar e Investir em Santa Catarina" description="Compare cidades, simule custo de vida e tome a melhor decisão para morar e investir em Santa Catarina com dados reais." schema={homeSchema}>

  <!--
    FUNIL DA HOME:
    1. Hero → captura atenção, direciona para calculadora ou guia
    2. Prova social (números) → credibilidade imediata
    3. Cidades → engajamento, exploração
    4. Calculadora → interação, tempo no site, CTA para guia
    5. Depoimentos → confiança, CTA para guia
    6. Artigos → SEO, conteúdo, autoridade
    7. Newsletter → conversão final
  -->

  <!-- 1. HERO — Atenção + direcionamento -->
  <HeroSlider />

  <!-- 2. PROVA SOCIAL — Números de autoridade -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-[1000px] mx-auto px-6 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-[26px] font-bold text-gray-900">4.200+</span>
          <span class="text-[12px] text-gray-400">famílias assessoradas</span>
        </div>
        <div>
          <span class="block text-[26px] font-bold text-gray-900">12</span>
          <span class="text-[12px] text-gray-400">cidades analisadas</span>
        </div>
        <div>
          <span class="block text-[26px] font-bold text-gray-900">R$ 2.8 bi</span>
          <span class="text-[12px] text-gray-400">em transações mapeadas</span>
        </div>
        <div>
          <span class="block text-[26px] font-bold text-gray-900">98%</span>
          <span class="text-[12px] text-gray-400">de satisfação</span>
        </div>
      </div>
    </div>
  </section>

  <!-- AD -->
  <div class="max-w-[1200px] mx-auto px-6 py-6">
    <AdSlot slot="horizontal" />
  </div>

  <!-- 3. CIDADES — Exploração + engajamento -->
  <section id="cidades" class="bg-brand-50 border-y border-brand-100/60">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Compare</span>
          <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1">Cidades em destaque</h2>
          <p class="text-[14px] text-gray-500 mt-2">Clique em uma cidade para ver o guia completo com dados de mercado.</p>
        </div>
        <a href="/categorias/cidades-para-morar" class="hidden sm:inline-flex items-center gap-1 text-[13px] font-medium text-brand-600 hover:text-brand-700">
          Ver todas <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {cidades.map(city => (
          <CityCard name={city.name} slug={city.slug} image={city.image} idh={city.idh} precoM2={city.precoM2} populacao={city.populacao} destaque={city.destaque} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. CALCULADORA — Interação + tempo no site + CTA -->
  <CostCalculator />

  <!-- 5. DEPOIMENTOS — Confiança + CTA -->
  <section class="bg-white">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="text-center mb-12">
        <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Resultados reais</span>
        <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1">Quem já usou, recomenda</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="border border-gray-200 rounded-xl p-6">
          <div class="flex gap-0.5 mb-3">{[1,2,3,4,5].map(() => <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>)}</div>
          <p class="text-[14px] text-gray-600 leading-relaxed mb-4">"Usei o guia para comparar BC e Floripa. Os dados de custo de vida me ajudaram a decidir. Hoje moro em Floripa e não me arrependo."</p>
          <p class="text-[14px] font-semibold text-gray-900">Ricardo M.</p>
          <p class="text-[12px] text-gray-400">Empresário — ex-São Paulo</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-6">
          <div class="flex gap-0.5 mb-3">{[1,2,3,4,5].map(() => <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>)}</div>
          <p class="text-[14px] text-gray-600 leading-relaxed mb-4">"A calculadora foi essencial. Achava que não conseguiria morar em BC, mas vi que com trabalho remoto é viável. Me mudei há 6 meses."</p>
          <p class="text-[14px] font-semibold text-gray-900">Camila R.</p>
          <p class="text-[12px] text-gray-400">Designer, remoto — ex-Curitiba</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-6">
          <div class="flex gap-0.5 mb-3">{[1,2,3,4,5].map(() => <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>)}</div>
          <p class="text-[14px] text-gray-600 leading-relaxed mb-4">"Comprei 2 aptos em Itapema após a análise de investimento. A valorização de 18% no primeiro ano confirmou tudo que o guia dizia."</p>
          <p class="text-[14px] font-semibold text-gray-900">Fernando L.</p>
          <p class="text-[12px] text-gray-400">Investidor imobiliário — ex-SP</p>
        </div>
      </div>
      <div class="text-center mt-10">
        <a href="#newsletter" class="inline-flex items-center gap-2 bg-brand-600 text-white text-[14px] font-semibold px-6 py-3 rounded-md hover:bg-brand-700 transition-colors">
          Quero receber o guia gratuito
        </a>
      </div>
    </div>
  </section>

  <!-- 6. ARTIGOS — Autoridade + SEO -->
  <section class="bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Conteúdo</span>
          <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1">Artigos recentes</h2>
        </div>
        <a href="/blog" class="hidden sm:inline-flex items-center gap-1 text-[13px] font-medium text-brand-600 hover:text-brand-700">
          Ver todos <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {posts.map(post => (
          <PostCard title={post.data.title} description={post.data.description} slug={post.id} pubDate={post.data.pubDate} categoria={post.data.categoria} cidade={post.data.cidade} heroImage={post.data.heroImage} />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. NEWSLETTER — Conversão final -->
  <NewsletterForm />

</Base>
