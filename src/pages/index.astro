---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import PostCard from '../components/PostCard.astro';
import CityCard from '../components/CityCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const cidades = [
  { name: 'Balneário Camboriú', slug: 'morar-em-balneario-camboriu', image: '/images/cidades/balneario-camboriu.jpg', idh: 0.845, precoM2: '14.5k', populacao: '156k', destaque: 'Mais valorizada' },
  { name: 'Florianópolis', slug: 'morar-em-florianopolis', image: '/images/cidades/florianopolis.jpg', idh: 0.847, precoM2: '11.2k', populacao: '516k', destaque: 'Capital' },
  { name: 'Joinville', slug: 'morar-em-joinville', image: '/images/cidades/joinville.jpg', idh: 0.809, precoM2: '7.8k', populacao: '616k', destaque: 'Maior empregabilidade' },
  { name: 'Itapema', slug: 'morar-em-itapema', image: '/images/cidades/itapema.jpg', idh: 0.796, precoM2: '12.1k', populacao: '73k', destaque: 'Maior potencial de investimento' },
];
---

<Base title="Morar e Investir em Santa Catarina" description="Inteligência de mercado e guias aprofundados para quem quer morar e investir em Santa Catarina com qualidade de vida.">

  <!-- HERO -->
  <HeroSlider />

  <!-- STATS -->
  <div class="relative z-10 -mt-10 max-w-[900px] mx-auto px-6">
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100">
      <div class="px-5 py-4 text-center">
        <span class="block text-[22px] font-bold text-gray-900">295+</span>
        <span class="block text-[11px] text-gray-400 mt-0.5">Municípios</span>
      </div>
      <div class="px-5 py-4 text-center">
        <span class="block text-[22px] font-bold text-gray-900">0.808</span>
        <span class="block text-[11px] text-gray-400 mt-0.5">IDH médio</span>
      </div>
      <div class="px-5 py-4 text-center">
        <span class="block text-[22px] font-bold text-gray-900">Top 3</span>
        <span class="block text-[11px] text-gray-400 mt-0.5">Segurança BR</span>
      </div>
      <div class="px-5 py-4 text-center">
        <span class="block text-[22px] font-bold text-gray-900">85%</span>
        <span class="block text-[11px] text-gray-400 mt-0.5">Satisfação</span>
      </div>
    </div>
  </div>

  <!-- AD -->
  <div class="max-w-[1200px] mx-auto px-6 pt-8 pb-2">
    <AdSlot slot="horizontal" />
  </div>

  <!-- CIDADES -->
  <section id="cidades" class="bg-brand-50 border-y border-brand-100/60">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-8">
        <div>
          <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Explore</span>
          <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1">Cidades em destaque</h2>
        </div>
        <a href="/categorias/cidades-para-morar" class="hidden sm:inline-flex items-center gap-1 text-[13px] font-medium text-brand-600 hover:text-brand-700">
          Ver todas <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {cidades.map(city => (
          <CityCard name={city.name} slug={city.slug} image={city.image} idh={city.idh} precoM2={city.precoM2} populacao={city.populacao} destaque={city.destaque} />
        ))}
      </div>
    </div>
  </section>

  <!-- ARTIGOS -->
  <section class="bg-white">
    <div class="max-w-[1200px] mx-auto px-6 py-20">
      <div class="grid lg:grid-cols-12 gap-14">
        <div class="lg:col-span-7">
          <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Publicações</span>
          <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1 mb-8">Artigos recentes</h2>
          <div class="space-y-8">
            {posts.map(post => (
              <PostCard title={post.data.title} description={post.data.description} slug={post.id} pubDate={post.data.pubDate} categoria={post.data.categoria} cidade={post.data.cidade} heroImage={post.data.heroImage} />
            ))}
          </div>
          {posts.length > 0 && (
            <div class="mt-8">
              <a href="/blog" class="inline-flex items-center gap-1.5 text-[13px] font-medium text-brand-600 hover:text-brand-700">
                Ver todos os artigos <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          )}
        </div>

        <aside class="lg:col-span-5 space-y-6">
          <div class="border border-gray-200 rounded-xl p-5">
            <h3 class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.15em] mb-4">Categorias</h3>
            <a href="/categorias/cidades-para-morar" class="flex items-center justify-between py-2.5 text-[14px] text-gray-700 hover:text-brand-600 border-b border-gray-100">Cidades para Morar <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg></a>
            <a href="/categorias/investimento-imobiliario" class="flex items-center justify-between py-2.5 text-[14px] text-gray-700 hover:text-brand-600 border-b border-gray-100">Investimento Imobiliário <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg></a>
            <a href="/categorias/custo-de-vida" class="flex items-center justify-between py-2.5 text-[14px] text-gray-700 hover:text-brand-600 border-b border-gray-100">Custo de Vida <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg></a>
            <a href="/categorias/qualidade-de-vida" class="flex items-center justify-between py-2.5 text-[14px] text-gray-700 hover:text-brand-600 border-b border-gray-100">Qualidade de Vida <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg></a>
            <a href="/categorias/trabalho-e-negocios" class="flex items-center justify-between py-2.5 text-[14px] text-gray-700 hover:text-brand-600">Trabalho e Negócios <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg></a>
          </div>

          <AdSlot slot="sidebar" />

          <div class="bg-brand-600 rounded-xl p-6">
            <span class="text-[11px] font-semibold text-brand-200 uppercase tracking-[0.12em]">Em destaque</span>
            <h3 class="text-[17px] font-bold text-white mt-1.5 mb-2 leading-snug">Por que SC é o estado que mais cresce no Brasil?</h3>
            <p class="text-[13px] text-brand-100/70 leading-relaxed mb-4">IDH elevado, segurança e mercado imobiliário em expansão atraem investidores de todo o país.</p>
            <a href="/blog" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-brand-600 bg-white px-4 py-2 rounded-md hover:bg-brand-50">
              Saiba mais <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <NewsletterForm />

</Base>
