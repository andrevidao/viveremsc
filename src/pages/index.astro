---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import PostCard from '../components/PostCard.astro';
import CityCard from '../components/CityCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const cidades = [
  { name: 'Balneário Camboriú', slug: 'morar-em-balneario-camboriu', image: '/images/cidades/balneario-camboriu.jpg', idh: 0.845, precoM2: '14.5k', populacao: '156k', destaque: 'Mais valorizada' },
  { name: 'Florianópolis', slug: 'morar-em-florianopolis', image: '/images/cidades/florianopolis.jpg', idh: 0.847, precoM2: '11.2k', populacao: '516k', destaque: 'Capital' },
  { name: 'Joinville', slug: 'morar-em-joinville', image: '/images/cidades/joinville.jpg', idh: 0.809, precoM2: '7.8k', populacao: '616k', destaque: 'Maior empregabilidade' },
  { name: 'Itapema', slug: 'morar-em-itapema', image: '/images/cidades/itapema.jpg', idh: 0.796, precoM2: '12.1k', populacao: '73k', destaque: 'Maior potencial de investimento' },
];
---

<Base title="Morar e Investir em Santa Catarina" description="Inteligência de mercado e guias aprofundados para quem quer morar e investir em Santa Catarina com qualidade de vida.">

  <!-- ==================== HERO SLIDER ==================== -->
  <HeroSlider />

  <!-- ==================== STATS BAR ==================== -->
  <div class="relative z-10 -mt-12 max-w-[960px] mx-auto px-6">
    <div class="bg-white rounded-2xl shadow-lg shadow-black/5 border border-gray-100 grid grid-cols-2 md:grid-cols-4">
      <div class="flex items-center gap-3 px-6 py-5 border-b md:border-b-0 md:border-r border-gray-100">
        <span class="w-10 h-10 rounded-xl bg-ocean-50 flex items-center justify-center text-ocean-600 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
        </span>
        <div>
          <span class="block text-[20px] font-bold text-gray-900 leading-none">295+</span>
          <span class="block text-[11px] text-gray-400 font-medium mt-0.5">Municípios</span>
        </div>
      </div>
      <div class="flex items-center gap-3 px-6 py-5 border-b md:border-b-0 md:border-r border-gray-100">
        <span class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
        </span>
        <div>
          <span class="block text-[20px] font-bold text-gray-900 leading-none">0.808</span>
          <span class="block text-[11px] text-gray-400 font-medium mt-0.5">IDH médio</span>
        </div>
      </div>
      <div class="flex items-center gap-3 px-6 py-5 md:border-r border-gray-100">
        <span class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        </span>
        <div>
          <span class="block text-[20px] font-bold text-gray-900 leading-none">Top 3</span>
          <span class="block text-[11px] text-gray-400 font-medium mt-0.5">Segurança BR</span>
        </div>
      </div>
      <div class="flex items-center gap-3 px-6 py-5">
        <span class="w-10 h-10 rounded-xl bg-violet-50 flex items-center justify-center text-violet-600 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </span>
        <div>
          <span class="block text-[20px] font-bold text-gray-900 leading-none">85%</span>
          <span class="block text-[11px] text-gray-400 font-medium mt-0.5">Satisfação</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== AD SLOT ==================== -->
  <div class="max-w-[1200px] mx-auto px-6 pt-10 pb-4">
    <AdSlot slot="horizontal" />
  </div>

  <!-- ==================== CIDADES ==================== -->
  <section id="cidades" class="max-w-[1200px] mx-auto px-6 pb-24">
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="text-[11px] font-semibold text-ocean-600 uppercase tracking-[0.2em]">Explore</span>
        <h2 class="text-[32px] md:text-[40px] font-bold text-gray-900 tracking-tight mt-1">Cidades em destaque</h2>
      </div>
      <a href="/categorias/cidades-para-morar" class="hidden sm:inline-flex items-center gap-1.5 text-[13px] font-medium text-gray-500 hover:text-gray-900 transition-colors">
        Ver todas
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {cidades.map(city => (
        <CityCard
          name={city.name}
          slug={city.slug}
          image={city.image}
          idh={city.idh}
          precoM2={city.precoM2}
          populacao={city.populacao}
          destaque={city.destaque}
        />
      ))}
    </div>
  </section>

  <!-- ==================== FEATURED CONTENT ==================== -->
  <section class="border-t border-gray-100">
    <div class="max-w-[1200px] mx-auto px-6 py-24">
      <div class="grid lg:grid-cols-12 gap-16">
        <!-- Main content -->
        <div class="lg:col-span-7">
          <div class="flex items-end justify-between mb-10">
            <div>
              <span class="text-[11px] font-semibold text-ocean-600 uppercase tracking-[0.2em]">Publicações</span>
              <h2 class="text-[32px] md:text-[40px] font-bold text-gray-900 tracking-tight mt-1">Artigos recentes</h2>
            </div>
          </div>

          <div class="space-y-10">
            {posts.map(post => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                slug={post.id}
                pubDate={post.data.pubDate}
                categoria={post.data.categoria}
                cidade={post.data.cidade}
                heroImage={post.data.heroImage}
              />
            ))}
          </div>

          {posts.length > 0 && (
            <div class="mt-10">
              <a href="/blog" class="inline-flex items-center gap-2 text-[13px] font-medium text-gray-500 hover:text-gray-900 transition-colors border border-gray-200 px-5 py-2.5 rounded-full hover:border-gray-400">
                Ver todos os artigos
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-5">
          <!-- Categorias -->
          <div class="mb-12">
            <h3 class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.2em] mb-6">Categorias</h3>
            <div class="space-y-1">
              <a href="/categorias/cidades-para-morar" class="flex items-center justify-between py-3.5 border-b border-gray-100 group">
                <span class="text-[14px] font-medium text-gray-700 group-hover:text-gray-900 transition-colors">Cidades para Morar</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-gray-900 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
              </a>
              <a href="/categorias/investimento-imobiliario" class="flex items-center justify-between py-3.5 border-b border-gray-100 group">
                <span class="text-[14px] font-medium text-gray-700 group-hover:text-gray-900 transition-colors">Investimento Imobiliário</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-gray-900 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
              </a>
              <a href="/categorias/custo-de-vida" class="flex items-center justify-between py-3.5 border-b border-gray-100 group">
                <span class="text-[14px] font-medium text-gray-700 group-hover:text-gray-900 transition-colors">Custo de Vida</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-gray-900 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
              </a>
              <a href="/categorias/qualidade-de-vida" class="flex items-center justify-between py-3.5 border-b border-gray-100 group">
                <span class="text-[14px] font-medium text-gray-700 group-hover:text-gray-900 transition-colors">Qualidade de Vida</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-gray-900 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
              </a>
              <a href="/categorias/trabalho-e-negocios" class="flex items-center justify-between py-3.5 border-b border-gray-100 group">
                <span class="text-[14px] font-medium text-gray-700 group-hover:text-gray-900 transition-colors">Trabalho e Negócios</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-gray-900 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>

          <!-- Ad Slot Sidebar -->
          <AdSlot slot="sidebar" class="mb-12" />

          <!-- Highlight box -->
          <div class="bg-gray-50 rounded-2xl p-7">
            <span class="text-[11px] font-semibold text-ocean-600 uppercase tracking-[0.15em]">Em destaque</span>
            <h3 class="text-[18px] font-bold text-gray-900 mt-2 mb-3 tracking-tight leading-snug">Por que Santa Catarina é o estado que mais cresce no Brasil?</h3>
            <p class="text-[14px] text-gray-500 leading-relaxed mb-4">IDH elevado, segurança acima da média e mercado imobiliário em expansão atraem investidores e famílias de todo o país.</p>
            <a href="/blog" class="inline-flex items-center gap-1.5 text-[13px] font-medium text-ocean-600 hover:text-ocean-700 transition-colors">
              Saiba mais
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ==================== NEWSLETTER ==================== -->
  <NewsletterForm />

</Base>
