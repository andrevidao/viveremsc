---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import PostAuthor from '../components/PostAuthor.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  cidade?: string;
  categoria: string;
  slug: string;
  fontes?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, cidade, categoria, slug, fontes = [] } = Astro.props;

const categoriaLabel: Record<string, string> = {
  'cidades-para-morar': 'Cidades para Morar',
  'investimento-imobiliario': 'Investimento Imobiliário',
  'custo-de-vida': 'Custo de Vida',
  'qualidade-de-vida': 'Qualidade de Vida',
  'trabalho-e-negocios': 'Trabalho e Negócios',
};

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Base title={title} description={description} ogImage={heroImage}>

  {heroImage ? (
    <div class="relative min-h-[420px] md:min-h-[480px] flex items-end bg-gray-900">
      <img src={heroImage} alt={title} class="absolute inset-0 w-full h-full object-cover opacity-70" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10" />
      <div class="relative max-w-[720px] mx-auto px-6 pb-10 w-full">
        <div class="flex items-center gap-3 mb-3">
          <a href={`/categorias/${categoria}`} class="text-[11px] font-semibold text-brand-300 uppercase tracking-[0.15em]">
            {categoriaLabel[categoria]}
          </a>
          {cidade && (
            <>
              <span class="w-0.5 h-0.5 rounded-full bg-white/30" />
              <span class="text-[11px] text-white/50 font-medium">{cidade}, SC</span>
            </>
          )}
        </div>
        <h1 class="text-[clamp(1.75rem,4vw,2.5rem)] font-bold text-white leading-[1.15] tracking-tight mb-3">{title}</h1>
        <div class="flex items-center gap-4 text-[13px] text-white/50">
          <time>{formattedDate}</time>
          {updatedDate && <span>Atualizado em {updatedDate.toLocaleDateString('pt-BR')}</span>}
        </div>
      </div>
    </div>
  ) : (
    <div class="max-w-[720px] mx-auto px-6 pt-16">
      <div class="flex items-center gap-3 mb-3">
        <a href={`/categorias/${categoria}`} class="text-[11px] font-semibold text-brand-600 uppercase tracking-[0.15em]">
          {categoriaLabel[categoria]}
        </a>
        {cidade && (
          <>
            <span class="w-0.5 h-0.5 rounded-full bg-gray-300" />
            <span class="text-[11px] text-gray-400 font-medium">{cidade}, SC</span>
          </>
        )}
      </div>
      <h1 class="text-[clamp(1.75rem,4vw,2.5rem)] font-bold text-gray-900 leading-[1.15] tracking-tight mb-3">{title}</h1>
      <div class="flex items-center gap-4 text-[13px] text-gray-400">
        <time>{formattedDate}</time>
        {updatedDate && <span>Atualizado em {updatedDate.toLocaleDateString('pt-BR')}</span>}
      </div>
    </div>
  )}

  <article class="max-w-[720px] mx-auto px-6 pt-10">
    <!-- Assinatura + fontes no início -->
    <PostAuthor fontes={fontes} />

    <AdSlot slot="horizontal" class="mb-10" />

    <div class="article-prose">
      <slot />
    </div>

    <!-- Assinatura no fim -->
    <PostAuthor fontes={fontes} />

    <AdSlot slot="horizontal" class="mt-8 mb-6" />

    <!-- Posts relacionados -->
    <RelatedPosts currentSlug={slug} categoria={categoria} />
  </article>

  <NewsletterForm
    title="Gostou desta análise?"
    description="Receba guias exclusivos sobre morar e investir em Santa Catarina. Direto no seu e-mail, sem spam."
  />

</Base>
