---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  cidade?: string;
  categoria: string;
}

const { title, description, pubDate, updatedDate, heroImage, cidade, categoria } = Astro.props;

const categoriaLabel: Record<string, string> = {
  'cidades-para-morar': 'Cidades para Morar',
  'investimento-imobiliario': 'Investimento Imobiliário',
  'custo-de-vida': 'Custo de Vida',
  'qualidade-de-vida': 'Qualidade de Vida',
  'trabalho-e-negocios': 'Trabalho e Negócios',
};

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Base title={title} description={description} ogImage={heroImage}>

  <!-- Hero image full width -->
  {heroImage && (
    <div class="relative h-[50vh] min-h-[360px] max-h-[500px] bg-gray-900">
      <img src={heroImage} alt={title} class="w-full h-full object-cover opacity-80" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
    </div>
  )}

  <article class="max-w-[720px] mx-auto px-6">
    <!-- Header -->
    <header class:list={[heroImage ? '-mt-24 relative z-10' : 'pt-16', 'mb-12']}>
      <div class="flex items-center gap-3 mb-4">
        <a href={`/categorias/${categoria}`} class="text-[11px] font-semibold text-ocean-600 uppercase tracking-[0.15em] hover:text-ocean-700 transition-colors">
          {categoriaLabel[categoria]}
        </a>
        {cidade && (
          <>
            <span class="w-0.5 h-0.5 rounded-full bg-gray-300" />
            <span class="text-[11px] text-gray-400 font-medium">{cidade}, SC</span>
          </>
        )}
      </div>

      <h1 class="text-[clamp(1.75rem,4vw,2.75rem)] font-bold text-white leading-[1.12] tracking-tight mb-5">
        {!heroImage && <span class="text-gray-900">{title}</span>}
        {heroImage && title}
      </h1>

      <div class="flex items-center gap-4 text-[13px]">
        <time class:list={[heroImage ? 'text-white/60' : 'text-gray-400']}>{formattedDate}</time>
        {updatedDate && (
          <span class:list={[heroImage ? 'text-white/40' : 'text-gray-300']}>
            Atualizado em {updatedDate.toLocaleDateString('pt-BR')}
          </span>
        )}
      </div>
    </header>

    <!-- Ad Slot -->
    <AdSlot slot="horizontal" class="mb-10" />

    <!-- Content -->
    <div class="prose prose-lg max-w-none
      prose-headings:text-gray-900 prose-headings:font-bold prose-headings:tracking-tight
      prose-p:text-gray-600 prose-p:leading-[1.8]
      prose-a:text-ocean-600 prose-a:font-medium prose-a:no-underline hover:prose-a:underline
      prose-strong:text-gray-900 prose-strong:font-semibold
      prose-li:text-gray-600
      prose-table:text-[14px]
      prose-th:bg-gray-50 prose-th:text-gray-900 prose-th:font-semibold prose-th:py-3
      prose-td:py-3 prose-td:border-gray-100
      prose-hr:border-gray-100
    ">
      <slot />
    </div>

    <!-- Ad Slot bottom -->
    <AdSlot slot="horizontal" class="mt-12 mb-6" />
  </article>

  <!-- Newsletter -->
  <div class="mt-16">
    <NewsletterForm
      title="Gostou desta análise?"
      description="Receba guias exclusivos sobre morar e investir em Santa Catarina. Direto no seu e-mail, sem spam."
    />
  </div>

</Base>
