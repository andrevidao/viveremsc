---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  cidade?: string;
  categoria: string;
}

const { title, description, pubDate, updatedDate, heroImage, cidade, categoria } = Astro.props;

const categoriaLabel: Record<string, string> = {
  'cidades-para-morar': 'Cidades para Morar',
  'investimento-imobiliario': 'Investimento Imobiliário',
  'custo-de-vida': 'Custo de Vida',
  'qualidade-de-vida': 'Qualidade de Vida',
  'trabalho-e-negocios': 'Trabalho e Negócios',
};

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Base title={title} description={description} ogImage={heroImage}>

  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-ocean-600">Início</a>
      <span class="mx-1">/</span>
      <a href={`/categorias/${categoria}`} class="hover:text-ocean-600">{categoriaLabel[categoria]}</a>
      <span class="mx-1">/</span>
      <span class="text-slate-700">{title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-ocean-600 bg-ocean-50 px-3 py-1 rounded-full">
          {categoriaLabel[categoria]}
        </span>
        {cidade && <span class="text-xs text-slate-500">{cidade}, SC</span>}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">{title}</h1>
      <p class="text-lg text-slate-600 mb-4">{description}</p>
      <div class="flex items-center gap-4 text-sm text-slate-400">
        <time>{formattedDate}</time>
        {updatedDate && <span>Atualizado em {updatedDate.toLocaleDateString('pt-BR')}</span>}
      </div>
    </header>

    {heroImage && (
      <img src={heroImage} alt={title} class="w-full rounded-xl mb-8 object-cover max-h-96" />
    )}

    <!-- Ad Slot Topo do Post -->
    <AdSlot slot="horizontal" class="mb-8" />

    <!-- Conteúdo MDX -->
    <div class="prose prose-lg max-w-none
      prose-headings:text-slate-800 prose-headings:font-bold
      prose-p:text-slate-700 prose-p:leading-relaxed
      prose-a:text-ocean-600 prose-a:font-medium prose-a:no-underline hover:prose-a:underline
      prose-strong:text-slate-800
      prose-li:text-slate-700
      prose-table:text-sm
      prose-th:bg-ocean-50 prose-th:text-slate-800
      prose-td:border-slate-200
    ">
      <slot />
    </div>

    <!-- Ad Slot Final do Post -->
    <AdSlot slot="horizontal" class="mt-8" />
  </article>

  <!-- Newsletter -->
  <NewsletterForm
    title="Gostou deste artigo?"
    description="Receba análises exclusivas sobre morar e investir em Santa Catarina direto no seu e-mail."
  />

</Base>
