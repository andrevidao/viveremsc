---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
  categoria?: string;
  limit?: number;
}

const { currentSlug, categoria, limit = 3 } = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter(p => p.id !== currentSlug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const related = categoria
  ? allPosts.filter(p => p.data.categoria === categoria).slice(0, limit)
  : [];

const posts = related.length > 0 ? related : allPosts.slice(0, limit);
---

{posts.length > 0 && (
  <div class="not-prose my-12">
    <h3 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 1.5rem 0;">Leia também</h3>
    <div class="grid md:grid-cols-3 gap-4">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="group block rounded-xl overflow-hidden border border-gray-200 hover:shadow-md transition-shadow no-underline">
          {post.data.heroImage && (
            <div class="aspect-[16/10] overflow-hidden">
              <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
          )}
          <div class="p-4">
            <p style="font-size: 11px; font-weight: 600; color: #4a9a8e; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 4px 0;">
              {post.data.cidade || post.data.categoria}
            </p>
            <p style="font-size: 15px; font-weight: 600; color: #111827; margin: 0; line-height: 1.35;">
              {post.data.title}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
