---
const cidades = [
  { value: 'balneario-camboriu', label: 'Balneário Camboriú', aluguel2q: 5500, aluguel3q: 11000, condo: 2000, mercado: 2400, escola: 2800, saude: 1100 },
  { value: 'florianopolis', label: 'Florianópolis', aluguel2q: 3800, aluguel3q: 7000, condo: 1200, mercado: 2200, escola: 2200, saude: 950 },
  { value: 'joinville', label: 'Joinville', aluguel2q: 2500, aluguel3q: 4500, condo: 700, mercado: 1800, escola: 1600, saude: 800 },
  { value: 'itapema', label: 'Itapema', aluguel2q: 3200, aluguel3q: 6000, condo: 1000, mercado: 2000, escola: 2000, saude: 900 },
];
---

<section id="calculadora" class="bg-brand-50 border-y border-brand-100/60">
  <div class="max-w-[1200px] mx-auto px-6 py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Ferramenta</span>
        <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1 mb-3">Quanto custa morar em SC?</h2>
        <p class="text-[15px] text-gray-500 leading-relaxed mb-6">Selecione uma cidade e veja a estimativa mensal para um casal com 1 filho. Valores baseados em dados de mercado de 2026.</p>
        <div class="bg-brand-600 rounded-lg p-5 text-white">
          <p class="text-[13px] text-brand-100/70 mb-2">Quer a análise completa das 10 melhores cidades?</p>
          <a href="#newsletter" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-brand-900 bg-white px-4 py-2 rounded-md hover:bg-brand-50 transition-colors">
            Baixar guia gratuito
          </a>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
        <label class="block text-[12px] font-semibold text-gray-400 uppercase tracking-[0.1em] mb-2">Cidade</label>
        <select id="calc-city" class="w-full px-4 py-3 rounded-md border border-gray-200 text-[14px] text-gray-800 bg-gray-50 focus:outline-none focus:border-brand-400 mb-6">
          {cidades.map(c => <option value={c.value}>{c.label}</option>)}
        </select>

        <div class="space-y-3 mb-6">
          <div class="flex justify-between text-[14px]">
            <span class="text-gray-500">Aluguel (2 quartos)</span>
            <span id="calc-aluguel2q" class="font-semibold text-gray-900">R$ 5.500</span>
          </div>
          <div class="flex justify-between text-[14px]">
            <span class="text-gray-500">Aluguel (3 quartos)</span>
            <span id="calc-aluguel3q" class="font-semibold text-gray-900">R$ 11.000</span>
          </div>
          <div class="flex justify-between text-[14px]">
            <span class="text-gray-500">Condomínio</span>
            <span id="calc-condo" class="font-semibold text-gray-900">R$ 2.000</span>
          </div>
          <div class="flex justify-between text-[14px]">
            <span class="text-gray-500">Supermercado (casal)</span>
            <span id="calc-mercado" class="font-semibold text-gray-900">R$ 2.400</span>
          </div>
          <div class="flex justify-between text-[14px]">
            <span class="text-gray-500">Escola particular</span>
            <span id="calc-escola" class="font-semibold text-gray-900">R$ 2.800</span>
          </div>
          <div class="flex justify-between text-[14px]">
            <span class="text-gray-500">Plano de saúde</span>
            <span id="calc-saude" class="font-semibold text-gray-900">R$ 1.100</span>
          </div>
        </div>

        <div class="border-t border-gray-100 pt-4 flex justify-between items-center">
          <span class="text-[14px] font-semibold text-gray-700">Estimativa mensal total</span>
          <span id="calc-total" class="text-[22px] font-bold text-brand-600">R$ 24.800</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ cidades }}>
  const select = document.getElementById('calc-city');
  const fields = ['aluguel2q', 'aluguel3q', 'condo', 'mercado', 'escola', 'saude'];

  function fmt(n) { return 'R$ ' + n.toLocaleString('pt-BR'); }

  function update() {
    const city = cidades.find(c => c.value === select.value);
    if (!city) return;
    fields.forEach(f => {
      document.getElementById('calc-' + f).textContent = fmt(city[f]);
    });
    const total = city.aluguel2q + city.condo + city.mercado + city.escola + city.saude;
    document.getElementById('calc-total').textContent = fmt(total);
  }

  select.addEventListener('change', update);
</script>
