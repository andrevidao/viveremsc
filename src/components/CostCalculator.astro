---
// Dados reais — Fontes: FipeZap+, Numbeo, MySide, Melhor Escola, Unimed/ANS (2025-2026)
const cidades = [
  { value: 'balneario-camboriu', label: 'Balneário Camboriú', aluguel2q: 4500, aluguel3q: 6500, condo: 1500, mercado: 1200, escola: 1500, saude: 650 },
  { value: 'florianopolis', label: 'Florianópolis', aluguel2q: 4200, aluguel3q: 5938, condo: 1200, mercado: 1200, escola: 1600, saude: 650 },
  { value: 'joinville', label: 'Joinville', aluguel2q: 2500, aluguel3q: 3875, condo: 900, mercado: 1000, escola: 1436, saude: 600 },
  { value: 'itapema', label: 'Itapema', aluguel2q: 3000, aluguel3q: 5000, condo: 1300, mercado: 1100, escola: 1300, saude: 650 },
];

const labels = [
  { key: 'aluguel2q', label: 'Aluguel (2 quartos)' },
  { key: 'aluguel3q', label: 'Aluguel (3 quartos)' },
  { key: 'condo', label: 'Condomínio' },
  { key: 'mercado', label: 'Supermercado (casal)' },
  { key: 'escola', label: 'Escola particular' },
  { key: 'saude', label: 'Plano de saúde' },
];
---

<section id="calculadora" class="bg-brand-50 border-y border-brand-100/60">
  <div class="max-w-[1200px] mx-auto px-6 py-20">
    <div class="text-center mb-10">
      <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Comparador</span>
      <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1">Compare o custo de vida entre cidades</h2>
      <p class="text-[15px] text-gray-500 mt-2">Selecione duas cidades e veja lado a lado. Valores mensais para casal + 1 filho.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <!-- Cidade A -->
      <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
        <select id="calc-a" class="w-full px-4 py-3 rounded-md border border-gray-200 text-[14px] text-gray-800 bg-gray-50 focus:outline-none focus:border-brand-400 mb-5 font-semibold">
          {cidades.map((c, i) => <option value={c.value} selected={i === 0}>{c.label}</option>)}
        </select>
        <div class="space-y-0">
          {labels.map(l => (
            <div class="flex justify-between text-[14px] py-2.5 border-b border-gray-100">
              <span class="text-gray-500">{l.label}</span>
              <span id={`a-${l.key}`} class="font-semibold text-gray-900">-</span>
            </div>
          ))}
        </div>
        <div class="flex justify-between items-center pt-4 mt-2">
          <span class="text-[13px] font-semibold text-gray-600">Total mensal</span>
          <span id="a-total" class="text-[20px] font-bold text-brand-600">-</span>
        </div>
      </div>

      <!-- Cidade B -->
      <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
        <select id="calc-b" class="w-full px-4 py-3 rounded-md border border-gray-200 text-[14px] text-gray-800 bg-gray-50 focus:outline-none focus:border-brand-400 mb-5 font-semibold">
          {cidades.map((c, i) => <option value={c.value} selected={i === 1}>{c.label}</option>)}
        </select>
        <div class="space-y-0">
          {labels.map(l => (
            <div class="flex justify-between text-[14px] py-2.5 border-b border-gray-100">
              <span class="text-gray-500">{l.label}</span>
              <span id={`b-${l.key}`} class="font-semibold text-gray-900">-</span>
            </div>
          ))}
        </div>
        <div class="flex justify-between items-center pt-4 mt-2">
          <span class="text-[13px] font-semibold text-gray-600">Total mensal</span>
          <span id="b-total" class="text-[20px] font-bold text-brand-600">-</span>
        </div>
      </div>
    </div>

    <p class="text-[11px] text-gray-400 mt-3 text-center">Fontes: FipeZap+, Numbeo, MySide, Melhor Escola, Unimed/ANS — dados 2025-2026. Valores médios para centro/região nobre.</p>

    <!-- CTA -->
    <div class="text-center mt-8">
      <p class="text-[15px] text-gray-600 mb-3">Quer a análise completa das 10 melhores cidades?</p>
      <a href="#newsletter" class="inline-flex items-center gap-2 bg-brand-600 text-white text-[14px] font-semibold px-6 py-3 rounded-md hover:bg-brand-700 transition-colors">
        Baixar guia gratuito
      </a>
    </div>
  </div>
</section>

<script define:vars={{ cidades }}>
  const fields = ['aluguel2q', 'aluguel3q', 'condo', 'mercado', 'escola', 'saude'];
  function fmt(n) { return 'R$ ' + n.toLocaleString('pt-BR'); }

  function updateSide(prefix, selectId) {
    const sel = document.getElementById(selectId);
    const city = cidades.find(c => c.value === sel.value);
    if (!city) return;
    fields.forEach(f => {
      document.getElementById(prefix + '-' + f).textContent = fmt(city[f]);
    });
    const total = city.aluguel2q + city.condo + city.mercado + city.escola + city.saude;
    document.getElementById(prefix + '-total').textContent = fmt(total);
  }

  document.getElementById('calc-a').addEventListener('change', () => updateSide('a', 'calc-a'));
  document.getElementById('calc-b').addEventListener('change', () => updateSide('b', 'calc-b'));

  updateSide('a', 'calc-a');
  updateSide('b', 'calc-b');
</script>
