---
const slides = [
  { image: '/images/hero/slide-1.jpg', alt: 'Praia paradisíaca com águas turquesa' },
  { image: '/images/hero/slide-2.jpg', alt: 'Pôr do sol em praia brasileira' },
  { image: '/images/hero/slide-3.jpg', alt: 'Montanhas verdes com vista para o oceano' },
  { image: '/images/hero/slide-4.jpg', alt: 'Água cristalina e natureza exuberante' },
];
---

<section class="relative h-[85vh] min-h-[600px] max-h-[860px] flex items-center overflow-hidden">
  <div id="hero-slider" class="absolute inset-0">
    {slides.map((slide, i) => (
      <div class:list={['hero-slide absolute inset-0 transition-opacity duration-[1.5s] ease-in-out', i === 0 ? 'opacity-100' : 'opacity-0']} data-slide={i}>
        <img src={slide.image} alt={slide.alt} class="w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/40 to-transparent" />

  <div class="relative max-w-[1200px] mx-auto px-6 w-full">
    <div class="max-w-[540px]">
      <p class="text-[13px] font-medium text-white/50 uppercase tracking-[0.15em] mb-3">Atualizado em 2026</p>
      <h1 class="text-[clamp(2rem,4.5vw,3.25rem)] font-extrabold text-white leading-[1.1] tracking-[-0.02em] mb-4">
        Encontre o lugar ideal para viver e investir em
        <span class="text-brand-300">Santa Catarina</span>
      </h1>
      <p class="text-[15px] text-white/60 leading-relaxed mb-8 max-w-[420px]">
        Compare cidades, simule custo de vida e tome a melhor decisão com dados reais.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="#calculadora" class="bg-white text-gray-900 text-[14px] font-semibold px-6 py-3 rounded-md hover:bg-gray-100 transition-colors text-center">
          Simular custo de vida
        </a>
        <a href="#newsletter" class="bg-white/10 text-white text-[14px] font-medium px-6 py-3 rounded-md hover:bg-white/20 transition-colors border border-white/15 text-center">
          Receber guia gratuito
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2">
    {slides.map((_, i) => (
      <button class:list={['slider-dot w-1.5 h-1.5 rounded-full transition-all duration-500', i === 0 ? 'bg-white w-5' : 'bg-white/40']} data-dot={i} aria-label={`Slide ${i + 1}`} />
    ))}
  </div>
</section>

<script>
  let current = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slider-dot');
  const total = slides.length;
  function goTo(index: number) {
    slides[current].classList.replace('opacity-100', 'opacity-0');
    dots[current].classList.remove('bg-white', 'w-5');
    dots[current].classList.add('bg-white/40');
    current = index;
    slides[current].classList.replace('opacity-0', 'opacity-100');
    dots[current].classList.add('bg-white', 'w-5');
    dots[current].classList.remove('bg-white/40');
  }
  dots.forEach((dot, i) => { dot.addEventListener('click', () => goTo(i)); });
  setInterval(() => { goTo((current + 1) % total); }, 6000);
</script>
