---
interface Props {
  fontes?: string[];
}
const { fontes = [] } = Astro.props;
---

<div class="not-prose flex flex-col gap-3 my-8 py-5 border-y border-gray-200">
  <div class="flex items-center gap-3">
    <div class="w-9 h-9 rounded-full bg-brand-100 flex items-center justify-center">
      <span style="color: #387d73; font-size: 13px; font-weight: 700;">VS</span>
    </div>
    <div>
      <p style="color: #111827; font-size: 14px; font-weight: 600; margin: 0;">Redação ViverEmSC</p>
      <p style="color: #9ca3af; font-size: 12px; margin: 0;">Dados verificados com fontes públicas</p>
    </div>
  </div>
  {fontes.length > 0 && (
    <p style="color: #9ca3af; font-size: 11px; margin: 0; line-height: 1.6;">
      <span style="font-weight: 600; color: #6b7280;">Fontes:</span> {fontes.join(' · ')}
    </p>
  )}
</div>
