---
interface Props {
  cidade: string;
  estado?: string;
}
const { cidade, estado = 'Santa Catarina' } = Astro.props;
const query = encodeURIComponent(`${cidade}, ${estado}, Brasil`);
---

<div class="not-prose my-8">
  <h3 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 12px 0;">Onde fica {cidade}</h3>
  <div class="rounded-xl overflow-hidden border border-gray-200" style="height: 360px;">
    <iframe
      src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d50000!2d0!3d0!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2z${query}!5e0!3m2!1spt-BR!2sbr!4v1&q=${query}`}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={`Mapa de ${cidade}, ${estado}`}
    />
  </div>
</div>
