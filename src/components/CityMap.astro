---
interface Props {
  cidade: string;
  lat: number;
  lon: number;
  zoom?: number;
}
const { cidade, lat, lon, zoom = 12 } = Astro.props;
---

<div class="not-prose my-8">
  <h3 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 12px 0;">Onde fica {cidade}</h3>
  <div class="rounded-xl overflow-hidden border border-gray-200" style="height: 360px;">
    <iframe
      src={`https://www.openstreetmap.org/export/embed.html?bbox=${lon - 0.08}%2C${lat - 0.05}%2C${lon + 0.08}%2C${lat + 0.05}&layer=mapnik&marker=${lat}%2C${lon}`}
      width="100%"
      height="100%"
      style="border:0;"
      loading="lazy"
      title={`Mapa de ${cidade}, SC`}
    />
  </div>
</div>
