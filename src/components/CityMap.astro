---
interface Props {
  cidade: string;
  estado?: string;
}
const { cidade, estado = 'SC' } = Astro.props;
const query = encodeURIComponent(`${cidade}, ${estado}, Brasil`);
---

<div class="not-prose my-8">
  <h3 style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 12px 0;">Onde fica {cidade}</h3>
  <div class="rounded-xl overflow-hidden border border-gray-200" style="height: 360px;">
    <iframe
      src={`https://maps.google.com/maps?q=${query}&t=&z=12&ie=UTF8&iwloc=&output=embed`}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      title={`Mapa de ${cidade}, ${estado}`}
    />
  </div>
</div>
