---
const year = new Date().getFullYear();
---

<footer class="bg-brand-950 border-t border-brand-900">
  <div class="max-w-[1200px] mx-auto px-6 pt-14 pb-10">
    <div class="grid md:grid-cols-4 gap-10">
      <div>
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <img src="/images/logo-viveremsc.jpg" alt="Viver em SC" class="h-8 w-auto rounded" />
          <span class="text-[14px] font-bold text-white">Viver em SC</span>
        </a>
        <p class="text-[13px] text-brand-400/40 leading-relaxed max-w-[240px]">Inteligência de mercado para quem busca qualidade de vida em Santa Catarina.</p>
      </div>
      <div>
        <h4 class="text-[11px] font-semibold text-brand-500/60 uppercase tracking-[0.12em] mb-4">Categorias</h4>
        <ul class="space-y-2.5 text-[13px] text-brand-400/50">
          <li><a href="/categorias/cidades-para-morar" class="hover:text-white transition-colors">Cidades</a></li>
          <li><a href="/categorias/investimento-imobiliario" class="hover:text-white transition-colors">Investimento</a></li>
          <li><a href="/categorias/custo-de-vida" class="hover:text-white transition-colors">Custo de Vida</a></li>
          <li><a href="/categorias/qualidade-de-vida" class="hover:text-white transition-colors">Qualidade de Vida</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-[11px] font-semibold text-brand-500/60 uppercase tracking-[0.12em] mb-4">Cidades</h4>
        <ul class="space-y-2.5 text-[13px] text-brand-400/50">
          <li><a href="/blog/morar-em-balneario-camboriu" class="hover:text-white transition-colors">Balneário Camboriú</a></li>
          <li><a href="/blog/morar-em-florianopolis" class="hover:text-white transition-colors">Florianópolis</a></li>
          <li><a href="/blog/morar-em-joinville" class="hover:text-white transition-colors">Joinville</a></li>
          <li><a href="/blog/morar-em-itapema" class="hover:text-white transition-colors">Itapema</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-[11px] font-semibold text-brand-500/60 uppercase tracking-[0.12em] mb-4">Newsletter</h4>
        <form class="flex gap-2" action="#" method="POST">
          <input type="email" name="email" required placeholder="seu@email.com" class="flex-1 px-3 py-2 rounded-md bg-brand-900 border border-brand-800 text-[13px] text-white placeholder:text-brand-700 focus:outline-none focus:border-brand-600" />
          <button type="submit" class="px-4 py-2 bg-brand-600 text-white text-[13px] rounded-md hover:bg-brand-500">Assinar</button>
        </form>
      </div>
    </div>
    <div class="border-t border-brand-900 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-[11px] text-brand-800">&copy; {year} Viver em SC. Todos os direitos reservados.</p>
      <div class="flex gap-5 text-[11px] text-brand-800">
        <a href="/privacidade" class="hover:text-brand-500">Privacidade</a>
        <a href="/termos" class="hover:text-brand-500">Termos</a>
      </div>
    </div>
  </div>
</footer>
