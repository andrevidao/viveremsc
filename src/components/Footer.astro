---
const year = new Date().getFullYear();

const categorias = [
  { href: '/categorias/cidades-para-morar', label: 'Cidades para Morar' },
  { href: '/categorias/investimento-imobiliario', label: 'Investimento Imobiliário' },
  { href: '/categorias/custo-de-vida', label: 'Custo de Vida' },
  { href: '/categorias/qualidade-de-vida', label: 'Qualidade de Vida' },
  { href: '/categorias/trabalho-e-negocios', label: 'Trabalho e Negócios' },
];

const cidades = [
  { href: '/blog/morar-em-balneario-camboriu', label: 'Balneário Camboriú' },
  { href: '/blog/morar-em-florianopolis', label: 'Florianópolis' },
  { href: '/blog/morar-em-joinville', label: 'Joinville' },
  { href: '/blog/morar-em-blumenau', label: 'Blumenau' },
  { href: '/blog/morar-em-itapema', label: 'Itapema' },
];
---

<footer class="bg-warm-900 text-warm-300">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4">
          <img src="/images/logo-viveremsc.jpg" alt="Viver em SC" class="h-10 w-auto rounded-lg" />
          <span class="text-lg font-bold text-white">Viver em SC</span>
        </a>
        <p class="text-sm leading-relaxed text-warm-400 mb-6">
          Dados reais e guias práticos para quem quer morar e investir em Santa Catarina com qualidade de vida.
        </p>
        <div class="flex items-center gap-3">
          <a href="#" class="w-9 h-9 flex items-center justify-center rounded-lg bg-warm-800 hover:bg-ocean-600 transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 flex items-center justify-center rounded-lg bg-warm-800 hover:bg-ocean-600 transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Categorias -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Categorias</h3>
        <ul class="space-y-2.5">
          {categorias.map(cat => (
            <li>
              <a href={cat.href} class="text-sm hover:text-white transition-colors">{cat.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cidades -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Cidades Populares</h3>
        <ul class="space-y-2.5">
          {cidades.map(city => (
            <li>
              <a href={city.href} class="text-sm hover:text-white transition-colors">{city.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter mini -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Newsletter</h3>
        <p class="text-sm text-warm-400 mb-4">Receba análises exclusivas sobre o mercado imobiliário de SC.</p>
        <form class="flex flex-col gap-2" action="#" method="POST">
          <input
            type="email"
            name="email"
            required
            placeholder="Seu e-mail"
            class="px-3 py-2.5 rounded-lg bg-warm-800 border border-warm-700 text-sm text-white placeholder:text-warm-500 focus:outline-none focus:border-ocean-500 transition-colors"
          />
          <button type="submit" class="bg-ocean-600 text-white text-sm font-semibold py-2.5 rounded-lg hover:bg-ocean-500 transition-colors">
            Inscrever-se
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-warm-800">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-warm-500">&copy; {year} Viver em SC. Todos os direitos reservados.</p>
      <div class="flex items-center gap-4 text-xs text-warm-500">
        <a href="/privacidade" class="hover:text-warm-300 transition-colors">Privacidade</a>
        <a href="/termos" class="hover:text-warm-300 transition-colors">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
