---
const year = new Date().getFullYear();
---

<footer class="bg-teal-950 text-teal-300/60">
  <div class="max-w-[1200px] mx-auto px-6 pt-20 pb-12">
    <div class="grid md:grid-cols-12 gap-12">

      <div class="md:col-span-4">
        <a href="/" class="flex items-center gap-3 mb-5">
          <img src="/images/logo-viveremsc.jpg" alt="Viver em SC" class="h-9 w-auto rounded-md" />
          <span class="text-[15px] font-bold text-white tracking-tight">VIVER EM SC</span>
        </a>
        <p class="text-sm leading-relaxed text-teal-400/50 mb-6 max-w-xs">
          Inteligência de mercado e guias aprofundados para quem busca qualidade de vida e investimento em Santa Catarina.
        </p>
        <div class="flex gap-3">
          <a href="#" class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-900/50 hover:bg-teal-700/50 transition-colors" aria-label="Instagram">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" class="w-8 h-8 flex items-center justify-center rounded-full bg-teal-900/50 hover:bg-teal-700/50 transition-colors" aria-label="YouTube">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-[11px] font-semibold text-teal-400/70 uppercase tracking-[0.15em] mb-5">Categorias</h4>
        <ul class="space-y-3">
          <li><a href="/categorias/cidades-para-morar" class="text-[13px] hover:text-teal-200 transition-colors">Cidades</a></li>
          <li><a href="/categorias/investimento-imobiliario" class="text-[13px] hover:text-teal-200 transition-colors">Investimento</a></li>
          <li><a href="/categorias/custo-de-vida" class="text-[13px] hover:text-teal-200 transition-colors">Custo de Vida</a></li>
          <li><a href="/categorias/qualidade-de-vida" class="text-[13px] hover:text-teal-200 transition-colors">Qualidade de Vida</a></li>
          <li><a href="/categorias/trabalho-e-negocios" class="text-[13px] hover:text-teal-200 transition-colors">Negócios</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-[11px] font-semibold text-teal-400/70 uppercase tracking-[0.15em] mb-5">Cidades</h4>
        <ul class="space-y-3">
          <li><a href="/blog/morar-em-balneario-camboriu" class="text-[13px] hover:text-teal-200 transition-colors">Balneário Camboriú</a></li>
          <li><a href="/blog/morar-em-florianopolis" class="text-[13px] hover:text-teal-200 transition-colors">Florianópolis</a></li>
          <li><a href="/blog/morar-em-joinville" class="text-[13px] hover:text-teal-200 transition-colors">Joinville</a></li>
          <li><a href="/blog/morar-em-itapema" class="text-[13px] hover:text-teal-200 transition-colors">Itapema</a></li>
          <li><a href="/blog/morar-em-blumenau" class="text-[13px] hover:text-teal-200 transition-colors">Blumenau</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <h4 class="text-[11px] font-semibold text-teal-400/70 uppercase tracking-[0.15em] mb-5">Newsletter</h4>
        <p class="text-[13px] text-teal-400/50 mb-4 leading-relaxed">Análises de mercado e oportunidades de investimento em SC.</p>
        <form class="flex gap-2" action="#" method="POST">
          <input type="email" name="email" required placeholder="seu@email.com" class="flex-1 px-4 py-2.5 rounded-full bg-teal-900/50 border border-teal-800/50 text-[13px] text-white placeholder:text-teal-600 focus:outline-none focus:border-teal-600 transition-colors" />
          <button type="submit" class="px-5 py-2.5 bg-teal-600 text-white text-[13px] font-medium rounded-full hover:bg-teal-500 transition-colors whitespace-nowrap">
            Assinar
          </button>
        </form>
      </div>
    </div>

    <div class="border-t border-teal-900/50 mt-14 pt-7 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[12px] text-teal-700">&copy; {year} Viver em SC. Todos os direitos reservados.</p>
      <div class="flex gap-6 text-[12px] text-teal-700">
        <a href="/privacidade" class="hover:text-teal-400 transition-colors">Privacidade</a>
        <a href="/termos" class="hover:text-teal-400 transition-colors">Termos</a>
      </div>
    </div>
  </div>
</footer>
