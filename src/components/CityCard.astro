---
interface Props {
  name: string;
  slug: string;
  image: string;
  idh: number;
  precoM2: string;
  populacao: string;
  destaque?: string;
}

const { name, slug, image, idh, precoM2, populacao, destaque } = Astro.props;
---

<a href={`/blog/${slug}`} class="group relative block rounded-2xl overflow-hidden bg-white border border-warm-200 shadow-sm hover:shadow-xl transition-all duration-300">
  <!-- Image -->
  <div class="relative h-52 overflow-hidden">
    <img
      src={image}
      alt={`Morar em ${name}`}
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />

    {destaque && (
      <span class="absolute top-3 left-3 bg-gold-500 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm">
        {destaque}
      </span>
    )}

    <div class="absolute bottom-3 left-4">
      <h3 class="text-xl font-bold text-white drop-shadow-md">{name}</h3>
      <span class="text-sm text-white/80">Santa Catarina</span>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-3 divide-x divide-warm-100 px-1 py-4">
    <div class="text-center px-2">
      <span class="block text-[11px] font-medium text-warm-400 uppercase tracking-wide">IDH</span>
      <span class="block text-base font-bold text-nature-600 mt-0.5">{idh}</span>
    </div>
    <div class="text-center px-2">
      <span class="block text-[11px] font-medium text-warm-400 uppercase tracking-wide">R$/m&sup2;</span>
      <span class="block text-base font-bold text-ocean-600 mt-0.5">{precoM2}</span>
    </div>
    <div class="text-center px-2">
      <span class="block text-[11px] font-medium text-warm-400 uppercase tracking-wide">Pop.</span>
      <span class="block text-base font-bold text-warm-700 mt-0.5">{populacao}</span>
    </div>
  </div>

  <!-- CTA -->
  <div class="px-4 pb-4">
    <span class="block w-full text-center text-sm font-semibold text-ocean-600 bg-ocean-50 group-hover:bg-ocean-600 group-hover:text-white py-2.5 rounded-xl transition-all duration-200">
      Ver guia completo
    </span>
  </div>
</a>
