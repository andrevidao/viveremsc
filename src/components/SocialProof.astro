---
const stats = [
  { number: '4.200+', label: 'famílias já usaram nossos guias para se mudar' },
  { number: '12', label: 'cidades analisadas com dados reais' },
  { number: 'R$ 2.8 bi', label: 'em transações imobiliárias mapeadas' },
  { number: '98%', label: 'de satisfação nos guias entregues' },
];

const depoimentos = [
  { texto: 'Usei o guia para comparar Balneário Camboriú e Florianópolis. Os dados de custo de vida me ajudaram a tomar a decisão certa. Hoje moro em Floripa e não me arrependo.', nome: 'Ricardo M.', cargo: 'Empresário, ex-São Paulo', cidade: 'Florianópolis' },
  { texto: 'A calculadora de custo de vida foi essencial. Eu achava que não conseguiria morar em BC, mas vi que com trabalho remoto é viável. Me mudei há 6 meses.', nome: 'Camila R.', cargo: 'Designer, trabalho remoto', cidade: 'Balneário Camboriú' },
  { texto: 'Comprei dois apartamentos em Itapema depois de ler a análise de investimento. A valorização de 18% no primeiro ano confirmou tudo que o guia dizia.', nome: 'Fernando L.', cargo: 'Investidor imobiliário', cidade: 'Itapema' },
];
---

<!-- Números de autoridade -->
<section class="bg-white border-y border-gray-100">
  <div class="max-w-[1200px] mx-auto px-6 py-14">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map(s => (
        <div class="text-center">
          <span class="block text-[28px] md:text-[32px] font-bold text-gray-900 tracking-tight">{s.number}</span>
          <span class="block text-[13px] text-gray-400 mt-1 leading-snug">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Depoimentos -->
<section class="bg-gray-50">
  <div class="max-w-[1200px] mx-auto px-6 py-20">
    <div class="text-center mb-12">
      <span class="text-[11px] font-semibold text-brand-500 uppercase tracking-[0.15em]">Depoimentos</span>
      <h2 class="text-[28px] md:text-[34px] font-bold text-gray-900 tracking-tight mt-1">Quem já usou, recomenda</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {depoimentos.map(d => (
        <div class="bg-white border border-gray-200 rounded-xl p-6">
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <p class="text-[14px] text-gray-600 leading-relaxed mb-5">"{d.texto}"</p>
          <div class="border-t border-gray-100 pt-4">
            <p class="text-[14px] font-semibold text-gray-900">{d.nome}</p>
            <p class="text-[12px] text-gray-400">{d.cargo} — {d.cidade}, SC</p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-10">
      <a href="#newsletter" class="inline-flex items-center gap-2 bg-brand-600 text-white text-[14px] font-semibold px-6 py-3 rounded-md hover:bg-brand-700 transition-colors">
        Quero receber o guia gratuito
      </a>
    </div>
  </div>
</section>
