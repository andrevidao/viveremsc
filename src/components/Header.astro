---
const navLinks = [
  { href: '/blog', label: 'Artigos' },
  { href: '/categorias/cidades-para-morar', label: 'Cidades' },
  { href: '/categorias/investimento-imobiliario', label: 'Investimento' },
  { href: '/categorias/custo-de-vida', label: 'Custo de Vida' },
  { href: '/categorias/qualidade-de-vida', label: 'Qualidade de Vida' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-teal-100/40">
  <nav class="max-w-[1200px] mx-auto px-6 h-[72px] flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo-viveremsc.jpg" alt="Viver em SC" class="h-10 w-auto rounded-md" />
      <div class="hidden sm:flex flex-col">
        <span class="text-[15px] font-bold text-teal-900 tracking-tight leading-none">VIVER EM SC</span>
        <span class="text-[10px] text-teal-500 font-medium tracking-[0.2em] uppercase mt-0.5">Morar &middot; Investir &middot; Viver</span>
      </div>
    </a>

    <ul class="hidden lg:flex items-center gap-0.5">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="px-3.5 py-2 text-[13px] font-medium text-teal-700/70 hover:text-teal-900 transition-colors">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="#newsletter"
        class="hidden md:inline-flex items-center gap-2 bg-teal-600 text-white text-[13px] font-medium px-5 py-2.5 rounded-full hover:bg-teal-700 transition-colors shadow-sm shadow-teal-600/20"
      >
        Receber Guia
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>

      <button id="menu-toggle" class="lg:hidden p-2 text-teal-700 hover:text-teal-900 transition-colors" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-teal-100/40 bg-white">
    <ul class="flex flex-col py-3 px-6">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="block py-3 text-[14px] font-medium text-teal-700 hover:text-teal-900 border-b border-teal-50 transition-colors">
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-4 pb-2">
        <a href="#newsletter" class="block text-center bg-teal-600 text-white font-medium py-3 rounded-full text-[14px]">
          Receber Guia Gratuito
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
