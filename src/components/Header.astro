---
const navLinks = [
  { href: '/blog', label: 'Artigos' },
  { href: '/categorias/cidades-para-morar', label: 'Cidades' },
  { href: '/categorias/investimento-imobiliario', label: 'Investimento' },
  { href: '/categorias/custo-de-vida', label: 'Custo de Vida' },
  { href: '/categorias/qualidade-de-vida', label: 'Qualidade de Vida' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200/60">
  <nav class="max-w-[1200px] mx-auto px-6 h-[68px] flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/images/logo-viveremsc.jpg" alt="Viver em SC" class="h-9 w-auto rounded" />
      <div class="hidden sm:flex flex-col">
        <span class="text-[14px] font-bold text-gray-900 tracking-tight leading-none">Viver em SC</span>
        <span class="text-[10px] text-gray-400 font-medium tracking-[0.12em] uppercase mt-0.5">Morar &middot; Investir &middot; Viver</span>
      </div>
    </a>

    <ul class="hidden lg:flex items-center gap-1">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="px-3 py-2 text-[13px] font-medium text-gray-500 hover:text-gray-900 transition-colors">{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a href="#newsletter" class="hidden md:inline-flex items-center gap-2 bg-brand-600 text-white text-[13px] font-medium px-5 py-2 rounded-md hover:bg-brand-700 transition-colors">
        Receber Guia
      </a>
      <button id="menu-toggle" class="lg:hidden p-2 text-gray-500" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white">
    <ul class="flex flex-col py-2 px-6">
      {navLinks.map(link => (
        <li><a href={link.href} class="block py-3 text-[14px] text-gray-600 border-b border-gray-50">{link.label}</a></li>
      ))}
      <li class="pt-3 pb-2"><a href="#newsletter" class="block text-center bg-brand-600 text-white py-2.5 rounded-md text-[14px]">Receber Guia</a></li>
    </ul>
  </div>
</header>

<script>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
