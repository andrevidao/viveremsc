---
const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Artigos' },
  { href: '/categorias/cidades-para-morar', label: 'Cidades' },
  { href: '/categorias/investimento-imobiliario', label: 'Investimento' },
  { href: '/categorias/custo-de-vida', label: 'Custo de Vida' },
];
---

<header class="bg-white/95 backdrop-blur-md border-b border-warm-200/60 sticky top-0 z-50">
  <!-- Top bar -->
  <div class="bg-ocean-900 text-ocean-100 text-xs py-1.5 hidden md:block">
    <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
      <span>Seu guia completo para morar e investir em Santa Catarina</span>
      <div class="flex items-center gap-4">
        <a href="#newsletter" class="hover:text-white transition-colors">Newsletter</a>
        <span class="text-ocean-700">|</span>
        <a href="/sobre" class="hover:text-white transition-colors">Sobre</a>
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img src="/images/logo-viveremsc.jpg" alt="Viver em SC" class="h-11 w-auto rounded-lg shadow-sm" />
      <div class="hidden sm:block">
        <span class="text-lg font-bold text-warm-900 tracking-tight">Viver em SC</span>
        <span class="block text-[11px] text-warm-500 -mt-0.5 font-medium tracking-wide uppercase">Morar &middot; Investir &middot; Viver</span>
      </div>
    </a>

    <ul class="hidden lg:flex items-center gap-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-warm-600 hover:text-ocean-600 hover:bg-ocean-50 rounded-lg transition-all"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="#newsletter"
        class="hidden md:inline-flex items-center gap-2 bg-ocean-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-ocean-700 shadow-sm shadow-ocean-600/20 transition-all hover:shadow-md hover:shadow-ocean-600/30"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Guia Gratuito
      </a>

      <button id="menu-toggle" class="lg:hidden p-2 text-warm-600 hover:bg-warm-100 rounded-lg transition-colors" aria-label="Abrir menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-warm-100 bg-white">
    <ul class="flex flex-col p-4 gap-1">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="block px-4 py-2.5 text-sm font-medium text-warm-600 hover:text-ocean-600 hover:bg-ocean-50 rounded-lg transition-all">
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2">
        <a href="#newsletter" class="block text-center bg-ocean-600 text-white font-semibold px-4 py-2.5 rounded-lg">
          Guia Gratuito
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
