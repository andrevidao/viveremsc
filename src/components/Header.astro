---
const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Artigos' },
  { href: '/categorias/cidades-para-morar', label: 'Cidades' },
  { href: '/categorias/investimento-imobiliario', label: 'Investimento' },
  { href: '/sobre', label: 'Sobre' },
];
---

<header class="bg-white/90 backdrop-blur-sm border-b border-ocean-100 sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/logo-viveremsc.jpg" alt="Viver em SC" class="h-10 w-auto rounded" />
    </a>

    <ul class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-700">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="hover:text-ocean-600 transition-colors">{link.label}</a>
        </li>
      ))}
    </ul>

    <a
      href="#newsletter"
      class="hidden md:inline-block bg-ocean-600 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-ocean-700 transition-colors"
    >
      Guia Gratuito
    </a>

    <!-- Mobile menu button -->
    <button id="menu-toggle" class="md:hidden p-2 text-slate-700" aria-label="Abrir menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-ocean-100 bg-white">
    <ul class="flex flex-col p-4 gap-3 text-sm font-medium text-slate-700">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="block py-1 hover:text-ocean-600">{link.label}</a>
        </li>
      ))}
      <li>
        <a href="#newsletter" class="block mt-2 text-center bg-ocean-600 text-white font-semibold px-4 py-2 rounded-lg">
          Guia Gratuito
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
