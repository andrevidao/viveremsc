---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  categoria: string;
  cidade?: string;
  heroImage?: string;
}

const { title, description, slug, pubDate, categoria, cidade, heroImage } = Astro.props;

const categoriaLabel: Record<string, string> = {
  'cidades-para-morar': 'Cidades',
  'investimento-imobiliario': 'Investimento',
  'custo-de-vida': 'Custo de Vida',
  'qualidade-de-vida': 'Qualidade de Vida',
  'trabalho-e-negocios': 'Negócios',
};

const categoriaColor: Record<string, string> = {
  'cidades-para-morar': 'bg-ocean-50 text-ocean-700',
  'investimento-imobiliario': 'bg-nature-50 text-nature-700',
  'custo-de-vida': 'bg-sand-50 text-sand-500',
  'qualidade-de-vida': 'bg-purple-50 text-purple-700',
  'trabalho-e-negocios': 'bg-warm-100 text-warm-700',
};

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article class="group bg-white rounded-2xl border border-warm-200/60 overflow-hidden hover:shadow-xl hover:border-warm-300 transition-all duration-300">
  {heroImage && (
    <a href={`/blog/${slug}`} class="block relative h-52 overflow-hidden">
      <img
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
    </a>
  )}

  <div class="p-5">
    <div class="flex items-center gap-2 mb-3">
      <span class:list={['text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full', categoriaColor[categoria] || 'bg-warm-100 text-warm-600']}>
        {categoriaLabel[categoria] || categoria}
      </span>
      {cidade && (
        <span class="text-[11px] text-warm-400 font-medium flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          {cidade}
        </span>
      )}
    </div>

    <a href={`/blog/${slug}`}>
      <h3 class="text-lg font-bold text-warm-900 group-hover:text-ocean-600 transition-colors mb-2 leading-snug line-clamp-2">
        {title}
      </h3>
    </a>

    <p class="text-sm text-warm-500 mb-4 leading-relaxed line-clamp-2">{description}</p>

    <div class="flex items-center justify-between pt-3 border-t border-warm-100">
      <time class="text-xs text-warm-400 font-medium">{formattedDate}</time>
      <a href={`/blog/${slug}`} class="text-sm font-semibold text-ocean-600 hover:text-ocean-700 flex items-center gap-1 group/link">
        Ler artigo
        <svg class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</article>
