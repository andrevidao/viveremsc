---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  categoria: string;
  cidade?: string;
  heroImage?: string;
}

const { title, description, slug, pubDate, categoria, cidade, heroImage } = Astro.props;

const categoriaLabel: Record<string, string> = {
  'cidades-para-morar': 'Cidades',
  'investimento-imobiliario': 'Investimento',
  'custo-de-vida': 'Custo de Vida',
  'qualidade-de-vida': 'Qualidade de Vida',
  'trabalho-e-negocios': 'Negócios',
};

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article class="group">
  {heroImage && (
    <a href={`/blog/${slug}`} class="block relative aspect-[16/10] rounded-xl overflow-hidden mb-4 bg-gray-100">
      <img
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
        loading="lazy"
      />
    </a>
  )}

  <div class="flex items-center gap-3 mb-2.5">
    <span class="text-[11px] font-semibold text-teal-600 uppercase tracking-[0.1em]">
      {categoriaLabel[categoria] || categoria}
    </span>
    {cidade && (
      <>
        <span class="w-0.5 h-0.5 rounded-full bg-gray-300" />
        <span class="text-[11px] text-gray-400 font-medium">{cidade}</span>
      </>
    )}
  </div>

  <a href={`/blog/${slug}`}>
    <h3 class="text-[17px] font-bold text-gray-900 group-hover:text-teal-600 transition-colors leading-snug mb-2 tracking-tight">
      {title}
    </h3>
  </a>

  <p class="text-[14px] text-gray-500 leading-relaxed mb-3 line-clamp-2">{description}</p>

  <div class="flex items-center gap-3">
    <time class="text-[12px] text-gray-400">{formattedDate}</time>
    <span class="w-0.5 h-0.5 rounded-full bg-gray-300" />
    <a href={`/blog/${slug}`} class="text-[12px] font-medium text-teal-600 hover:text-teal-700 transition-colors">
      Ler artigo
    </a>
  </div>
</article>
