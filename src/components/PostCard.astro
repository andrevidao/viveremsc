---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  categoria: string;
  cidade?: string;
  heroImage?: string;
}

const { title, description, slug, pubDate, categoria, cidade, heroImage } = Astro.props;

const categoriaLabel: Record<string, string> = {
  'cidades-para-morar': 'Cidades',
  'investimento-imobiliario': 'Investimento',
  'custo-de-vida': 'Custo de Vida',
  'qualidade-de-vida': 'Qualidade de Vida',
  'trabalho-e-negocios': 'Trabalho',
};

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article class="bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow group">
  {heroImage && (
    <a href={`/blog/${slug}`}>
      <img
        src={heroImage}
        alt={title}
        class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </a>
  )}

  <div class="p-5">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-xs font-semibold text-ocean-600 bg-ocean-50 px-2 py-1 rounded">
        {categoriaLabel[categoria] || categoria}
      </span>
      {cidade && (
        <span class="text-xs text-slate-500">{cidade}, SC</span>
      )}
    </div>

    <a href={`/blog/${slug}`}>
      <h3 class="text-lg font-bold text-slate-800 group-hover:text-ocean-600 transition-colors mb-2">
        {title}
      </h3>
    </a>

    <p class="text-sm text-slate-600 mb-4 line-clamp-2">{description}</p>

    <div class="flex items-center justify-between">
      <time class="text-xs text-slate-400">{formattedDate}</time>
      <a href={`/blog/${slug}`} class="text-sm font-semibold text-ocean-600 hover:text-ocean-700">
        Ler mais &rarr;
      </a>
    </div>
  </div>
</article>
