---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'As 10 melhores cidades de SC para investir em 2026',
  description = 'Análise completa com dados reais de mercado imobiliário, custo de vida e qualidade de vida. Entregue no seu e-mail.'
} = Astro.props;
---

<section id="newsletter" class="relative bg-gray-950 overflow-hidden">
  <!-- Subtle pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;" />

  <div class="relative max-w-[1200px] mx-auto px-6 py-24">
    <div class="max-w-2xl mx-auto text-center">
      <span class="inline-block text-[11px] font-semibold text-gray-400 uppercase tracking-[0.2em] mb-6 border border-gray-800 px-4 py-1.5 rounded-full">
        Guia Gratuito
      </span>

      <h2 class="text-3xl md:text-[42px] font-bold text-white leading-[1.15] tracking-tight mb-5">{title}</h2>
      <p class="text-gray-400 text-[16px] leading-relaxed mb-10">{description}</p>

      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" action="#" method="POST">
        <input
          type="email"
          name="email"
          required
          placeholder="seu@email.com"
          class="flex-1 px-5 py-3.5 rounded-full bg-white/5 border border-gray-800 text-white text-[14px] placeholder:text-gray-600 focus:outline-none focus:border-gray-600 transition-colors"
        />
        <button
          type="submit"
          class="bg-white text-gray-900 font-semibold px-7 py-3.5 rounded-full hover:bg-gray-200 transition-colors whitespace-nowrap text-[14px]"
        >
          Receber grátis
        </button>
      </form>

      <p class="text-[12px] text-gray-600 mt-5">Sem spam. Cancele quando quiser.</p>
    </div>
  </div>
</section>
