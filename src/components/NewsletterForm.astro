---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = '10 melhores cidades de Santa Catarina para morar ou investir',
  description = 'Análise completa com dados reais de mercado imobiliário, custo de vida e qualidade de vida.'
} = Astro.props;
---

<section id="newsletter" class="bg-brand-950">
  <div class="max-w-[600px] mx-auto px-6 py-20 text-center">
    <span class="inline-block text-[11px] font-semibold text-brand-400 uppercase tracking-[0.15em] mb-4">Guia Gratuito</span>
    <h2 class="text-[28px] md:text-[34px] font-bold text-white leading-tight tracking-tight mb-3">{title}</h2>
    <p class="text-brand-300/50 text-[14px] leading-relaxed mb-8">{description}</p>
    <form class="flex flex-col sm:flex-row gap-2 max-w-sm mx-auto" action="#" method="POST">
      <input type="email" name="email" required placeholder="seu@email.com" class="flex-1 px-4 py-3 rounded-md bg-brand-900 border border-brand-800 text-white text-[14px] placeholder:text-brand-700 focus:outline-none focus:border-brand-600" />
      <button type="submit" class="bg-white text-brand-800 font-semibold px-6 py-3 rounded-md hover:bg-gray-100 text-[14px]">Receber</button>
    </form>
    <p class="text-[11px] text-brand-800 mt-4">Sem spam. Cancele quando quiser.</p>
  </div>
</section>
