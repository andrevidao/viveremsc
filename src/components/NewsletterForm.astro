---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Receba o Guia Gratuito: As 10 Melhores Cidades de SC',
  description = 'Análise completa com dados de mercado imobiliário, custo de vida e qualidade de vida. Direto no seu e-mail.'
} = Astro.props;
---

<section id="newsletter" class="relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-ocean-800 via-ocean-900 to-ocean-950" />
  <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;0.15&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');" />

  <div class="relative max-w-3xl mx-auto px-6 py-20 text-center">
    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-ocean-200 text-xs font-semibold uppercase tracking-wider px-4 py-1.5 rounded-full mb-6">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      E-book Gratuito
    </div>

    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">{title}</h2>
    <p class="text-ocean-200 text-lg mb-10 max-w-xl mx-auto leading-relaxed">{description}</p>

    <form class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" action="#" method="POST">
      <input
        type="email"
        name="email"
        required
        placeholder="Seu melhor e-mail"
        class="flex-1 px-5 py-3.5 rounded-xl text-warm-800 bg-white placeholder:text-warm-400 focus:outline-none focus:ring-2 focus:ring-gold-400 shadow-lg text-sm"
      />
      <button
        type="submit"
        class="bg-gold-500 hover:bg-gold-400 text-warm-900 font-bold px-7 py-3.5 rounded-xl transition-all shadow-lg hover:shadow-xl whitespace-nowrap text-sm"
      >
        Quero Receber
      </button>
    </form>

    <div class="flex items-center justify-center gap-6 mt-8 text-xs text-ocean-300">
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        100% gratuito
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        Sem spam
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        Cancele quando quiser
      </span>
    </div>
  </div>
</section>
