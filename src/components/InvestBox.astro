---
interface Props {
  titulo: string;
  items: { label: string; value: string }[];
  nota?: string;
}
const { titulo, items, nota } = Astro.props;
---

<div class="invest-box" style="all: initial; display: block; font-family: Inter, system-ui, sans-serif; background: #387d73; color: white; border-radius: 0.75rem; padding: 1.5rem; margin: 2rem 0;">
  <p style="font-size: 11px; font-weight: 600; color: #a3cfc8; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 4px 0;">Investimento</p>
  <p style="font-size: 18px; font-weight: 700; color: white; margin: 0 0 1rem 0; line-height: 1.3;">{titulo}</p>
  {items.map(item => (
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.625rem 0; border-bottom: 1px solid rgba(255,255,255,0.15);">
      <span style="font-size: 14px; color: rgba(255,255,255,0.7);">{item.label}</span>
      <span style="font-size: 15px; font-weight: 700; color: white;">{item.value}</span>
    </div>
  ))}
  {nota && <p style="font-size: 12px; color: rgba(255,255,255,0.4); margin: 1rem 0 0 0; line-height: 1.5;">{nota}</p>}
</div>
