---
interface Props {
  titulo: string;
  items: { label: string; value: string }[];
  nota?: string;
}
const { titulo, items, nota } = Astro.props;
---

<div class="not-prose bg-brand-600 text-white rounded-xl p-6 my-8">
  <h4 class="text-[11px] font-semibold text-brand-200 uppercase tracking-[0.12em] mb-1">Investimento</h4>
  <h3 class="text-[18px] font-bold mb-4" style="color: #d1d5db;">{titulo}</h3>
  <div class="space-y-2.5">
    {items.map(item => (
      <div class="flex justify-between items-center py-2 border-b border-white/15 last:border-0">
        <span class="text-[14px] text-brand-100/80">{item.label}</span>
        <span class="text-[15px] font-bold">{item.value}</span>
      </div>
    ))}
  </div>
  {nota && <p class="text-[12px] text-brand-200/60 mt-4">{nota}</p>}
</div>
