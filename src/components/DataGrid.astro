---
interface Props {
  items: { label: string; value: string; detail?: string }[];
}
const { items } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 my-8 not-prose">
  {items.map(item => (
    <div class="bg-brand-50 border border-brand-100/60 rounded-lg p-4 text-center">
      <span class="block text-[22px] font-bold text-gray-900">{item.value}</span>
      <span class="block text-[12px] text-gray-500 mt-0.5">{item.label}</span>
      {item.detail && <span class="block text-[11px] text-brand-600 mt-1">{item.detail}</span>}
    </div>
  ))}
</div>
